{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aegis-prospective-outcome-v1",
  "additionalProperties": false,
  "properties": {
    "clean_quality": {"enum": [0, 1]},
    "fees_fraction": {"type": "number"},
    "funding_fraction": {"type": "number"},
    "gross_return_fraction": {"type": "number"},
    "horizon_bars": {"const": 12},
    "label_code_sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
    "label_config_sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
    "label_valid": {"type": "boolean"},
    "mae_fraction": {"minimum": 0, "type": "number"},
    "mfe_fraction": {"minimum": 0, "type": "number"},
    "missingness": {"items": {"type": "string"}, "type": "array"},
    "net_quality_after_costs": {"type": "number"},
    "net_return_fraction": {"type": "number"},
    "prospective_signal_id": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
    "qmae": {"minimum": 0, "type": "number"},
    "schema_id": {"const": "aegis-prospective-outcome-v1"},
    "slippage_fraction": {"type": "number"},
    "tail_event": {"enum": [0, 1]},
    "termination_reason": {"enum": ["HORIZON_COMPLETE", "INVALID_HORIZON"]},
    "termination_timestamp_utc": {"format": "date-time", "type": "string"},
    "validation_state": {"enum": ["VALID", "INVALID"]}
  },
  "required": ["schema_id", "prospective_signal_id", "horizon_bars", "termination_timestamp_utc", "gross_return_fraction", "net_return_fraction", "mfe_fraction", "mae_fraction", "tail_event", "qmae", "clean_quality", "net_quality_after_costs", "label_valid", "fees_fraction", "slippage_fraction", "funding_fraction", "termination_reason", "missingness", "validation_state", "label_code_sha256", "label_config_sha256"],
  "type": "object"
}
