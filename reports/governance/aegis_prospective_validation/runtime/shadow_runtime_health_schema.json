{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "activation_id": {"type": "string"},
    "checkpoint_status": {"type": "string"},
    "cohort_id": {"const": "aegis-prospective-shadow-cohort-1"},
    "configuration_identity": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
    "credential_read_count": {"minimum": 0, "type": "integer"},
    "disk_space_status": {"type": "string"},
    "duplicate_event_count": {"minimum": 0, "type": "integer"},
    "evaluated_candidate_count": {"minimum": 0, "type": "integer"},
    "journal_status": {"type": "string"},
    "model_identity": {"const": "aegis-prospective-shadow-candidate-v1"},
    "money_movement_count": {"minimum": 0, "type": "integer"},
    "order_call_count": {"minimum": 0, "type": "integer"},
    "persisted_evidence_count": {"minimum": 0, "type": "integer"},
    "private_call_count": {"minimum": 0, "type": "integer"},
    "public_connection_state": {"type": "string"},
    "reconnect_count": {"minimum": 0, "type": "integer"},
    "schema_id": {"const": "aegis-shadow-runtime-health-v1"},
    "service_state": {"type": "string"},
    "uptime_seconds": {"minimum": 0, "type": "number"}
  },
  "required": [
    "schema_id", "service_state", "activation_id", "cohort_id", "uptime_seconds",
    "public_connection_state", "evaluated_candidate_count", "persisted_evidence_count",
    "checkpoint_status", "journal_status", "model_identity", "configuration_identity",
    "private_call_count", "order_call_count", "credential_read_count", "money_movement_count"
  ],
  "title": "Aegis Shadow Runtime Health v1",
  "type": "object"
}
